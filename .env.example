# Copie para .env (cp .env.example .env) e ajuste.
# Lido pelo Docker Compose (docker-compose.yml) e pelos scripts/painel (lib/config.ts).

# --- Postgres (docker compose) ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
# Porta do Postgres no host (só em 127.0.0.1). Se mudar, ajuste a HUB_DATABASE_URL.
HUB_DB_PORT=5433

# Conexão dos scripts e do painel com o banco "hub"
HUB_DATABASE_URL=postgres://hub:hub@localhost:5433/hub

# --- Miniflux ---
# Porta do Miniflux no host. Se mudar, ajuste a MINIFLUX_URL.
MINIFLUX_PORT=8088
MINIFLUX_URL=http://localhost:8088
# O admin só é criado no primeiro `docker compose up`: troque a senha antes dele.
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=troque-esta-senha
# Opcional: chave de API (Miniflux > Configurações > Chaves de API). Se preenchida, tem prioridade sobre usuário/senha.
MINIFLUX_TOKEN=
# Intervalo de coleta dos feeds, em minutos
MINIFLUX_POLLING_MINUTES=60

# --- Hub ---
# Pasta dos digests em Markdown (pode apontar para um vault do Obsidian)
DIGEST_DIR=./digests
# Janela, em dias, dos itens considerados na curadoria
CURATE_DAYS=30
# 1 = notificação do macOS quando a ingestão encontra alerta de segurança
HUB_NOTIFY_MAC=0

# --- Curadoria headless (npm run curate:auto) ---
# Executável do Claude Code
CLAUDE_BIN=claude
# Argumentos extras para o `claude -p`, separados por espaço (opcional)
CLAUDE_CURATE_ARGS=
